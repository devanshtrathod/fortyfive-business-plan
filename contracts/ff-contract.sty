% FortyFive contract style. Latin Modern throughout, numbered clauses, fill-in lines and signature blocks.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ff-contract}[2026/10/15 FortyFive contracts]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage[a4paper,top=2.3cm,bottom=2.6cm,left=2.5cm,right=2.5cm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{amssymb}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em}
\linespread{1.06}

% ---------- what the document is called (set in each .tex) ----------
\newcommand{\doctitle}{}
\newcommand{\docversion}{}
\newcommand{\settitle}[1]{\renewcommand{\doctitle}{#1}}
\newcommand{\setversion}[1]{\renewcommand{\docversion}{#1}}

% ---------- running footer ----------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\textsc{FortyFive} \textperiodcentered{} \doctitle{} \textperiodcentered{} \docversion}
\fancyfoot[R]{\footnotesize Page \thepage{} of \pageref*{LastPage} \quad Initials \rule{1.6cm}{0.4pt}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\footnotesize Page \thepage{} of \pageref*{LastPage}}}

% ---------- clause headings: "4. Fees and payouts" ----------
\titleformat{\section}{\normalfont\large\bfseries}{\thesection.}{0.6em}{}
\titlespacing*{\section}{0pt}{1.3em}{0.3em}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{}{0em}{}
\titlespacing*{\subsection}{0pt}{1em}{0.2em}
\renewcommand{\thesection}{\arabic{section}}

% Numbered sub-clauses 4.1, 4.2 ... and lettered items (a), (b) ...
\newlist{clauses}{enumerate}{2}
\setlist[clauses,1]{label=\thesection.\arabic*, ref=\thesection.\arabic*, leftmargin=2.6em, labelsep=0.7em, itemsep=0.35em, topsep=0.2em}
\setlist[clauses,2]{label=(\alph*), ref=\thesection.\arabic{clausesi}(\alph*), leftmargin=2.2em, itemsep=0.15em, topsep=0.15em}
\setlist[itemize]{leftmargin=1.6em, itemsep=0.05em, topsep=0.15em}

% Schedules start on a new page with their own heading.
\newcommand{\schedule}[2]{%
  \clearpage
  \phantomsection\addcontentsline{toc}{section}{Schedule #1: #2}%
  {\large\bfseries Schedule #1\par}\vspace{0.15em}
  {\LARGE #2\par}\vspace{0.6em}\hrule\vspace{0.8em}}

% ---------- fill-ins ----------
\newcommand{\blank}[1][5cm]{\rule[-0.15em]{#1}{0.4pt}}
\newcommand{\ph}[1]{\textit{[#1]}}                       % a placeholder FortyFive fills in before sending
\newcommand{\tick}{\mbox{$\square$}\,}                      % a box to tick on paper
\newcommand{\field}[2][\linewidth]{%                        % a labelled line to write on
  \begin{minipage}[t]{#1}\vspace{1.1em}\rule{\linewidth}{0.4pt}\\[-0.1em]{\footnotesize #2}\end{minipage}}

% Signature block: \sigblock{Signed by the tutor}
\newcommand{\sigblock}[1]{%
  \needspace{9\baselineskip}%
  \par\vspace{1.6em}{\bfseries #1}\par\vspace{0.2em}
  \noindent\begin{tabularx}{\linewidth}{@{}X@{\hspace{1.2cm}}X@{}}
    \field{Signature} & \field{Full name, in capitals} \\[0.4em]
    \field{Date} & \field{Place}
  \end{tabularx}\par}

% A boxed note (for the parts a parent or tutor must not miss)
\newcommand{\keynote}[1]{%
  \par\vspace{0.3em}\noindent\fbox{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule}\setlength{\parskip}{0.4em}#1\end{minipage}}\par\vspace{0.3em}}

% Title block with the logo
\newcommand{\titleblock}[2]{%
  \thispagestyle{fancy}
  \noindent\includegraphics[height=0.95cm]{fortyfive-lockup.pdf}\hfill{\small\docversion}\par
  \vspace{1.4em}
  {\fontsize{24}{28}\selectfont #1\par}
  \vspace{0.5em}
  {\large\itshape #2\par}
  \vspace{0.8em}\hrule\vspace{0.6em}}

\endinput
